#!/usr/bin/env bash
# Git pre-commit hook to auto-generate a session and refresh MASTER_PROMPT.md
# so both are included in the SAME commit.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="${SCRIPT_DIR}/.."
PYTHON="python3"

cd "$REPO_ROOT"

# Generate session from current HEAD context (last commit + local state checks)
SESSION_PATH=$($PYTHON tools/generate_auto_session.py)

# Merge latest auto session into master prompt
$PYTHON tools/update_master_prompt.py "$SESSION_PATH"

# Stage generated artifacts into the current commit
git add prompts/MASTER_PROMPT.md "$SESSION_PATH" || true

exit 0
